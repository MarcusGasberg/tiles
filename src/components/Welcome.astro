---
const columns = Array.from({ length: 6 }, (_, i) => i + 1);
const images = Array.from({ length: 5 }, (_, i) => i);
const imageSpecs = {
  height: 500,
  width: 300,
};
const seed = Math.round(Math.random() * 10 + 200);
---

<div id="container" data-seed={seed}>
  {columns.map(col => (
  <div class="col" data-col={col}>
    <div class:list={['group', {'scroll-down': col % 2 === 0 , 'scroll-up': col % 2 !== 0  } ]}>
      {images.map(i => (
      <div class="card">
        <a href=`https://picsum.photos/seed/${seed * col + i }/${imageSpecs.width}/${imageSpecs.height}`>
          <img height={imageSpecs.height} src=`https://picsum.photos/seed/${seed * col + i }/${imageSpecs.width}/${imageSpecs.height}` />
        </a>
      </div>
      ))}
    </div>

    <!-- Add `aria-hidden` to hide the duplicated cards from screen readers. -->
    <div class:list={['group', {'scroll-down': col % 2 === 0 , 'scroll-up': col % 2 !==0 } ]} aria-hidden="true">
      {images.map(i => (
      <div class="card">
        <a href=`https://picsum.photos/seed/${seed * col + i }/${imageSpecs.width}/${imageSpecs.height}`>
          <img height={imageSpecs.height} src=`https://picsum.photos/seed/${seed * col + i }/${imageSpecs.width}/${imageSpecs.height}` />
        </a>
      </div>
      ))}
    </div>
  </div>
  ))}
</div>

<style>
  #container {
    display: grid;
    grid-template-columns: repeat(6, 300px);
    gap: 1rem;
    overflow: hidden;
    height: 200dvh;

    > * {
      flex: 0 0 100%;
    }
  }

  .card {
    display: flex;
    width: 100%;
    border-radius: 1rem;
    box-sizing: border-box;

    img {
      border-radius: 1rem;
      transition: transform 0.3s ease;
    }

    img:hover {
      transform: scale(1.02);
    }
  }

  .group {
    display: flex;
    gap: 1rem;
    height: fit-content;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .col:hover .group {
    animation-play-state: paused;
  }


  .scroll-down {
    animation: scroll-down 30s linear infinite;
  }

  .scroll-up {
    animation: scroll-up 30s linear infinite;
  }
  

  @keyframes scroll-down {
    0% {
      transform: translateY(-100%);
    }

    100% {
      transform: translateY(0);
    }
  }

  @keyframes scroll-up {
    from {
      transform: translateY(0);
    }

    to {
      transform: translateY(-100%);
    }
  }
</style>
